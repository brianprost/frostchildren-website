---
import { site } from "@/config/site"

interface Props {
	class?: string
	title?: string
	description?: string
}

const {
	class: className,
	title = "Join our mailing list",
	description = "Get updates on tour dates and releases."
} = Astro.props as Props
---

<section class:list={["mailing-list", className]}>
	<div class="mailing-list__intro">
		<h2>{title}</h2>
		<p>{description}</p>
	</div>
	<div class="mailing-list__form">
		<div class="_form_125"></div>
	</div>
	<p class="mailing-list__privacy">
		By subscribing, you agree to our
		<a href={site.privacyHref} target="_blank" rel="noopener noreferrer">
			Privacy Policy
		</a>.
	</p>
</section>

<script>
	if (!document.querySelector('script[data-frost-mailing-list]')) {
		const script = document.createElement("script")
		script.src = "https://dirtyhit.activehosted.com/f/embed.php?id=125"
		script.dataset.frostMailingList = "true"
		document.head.appendChild(script)
	}
</script>

<style>
	:global(.mailing-list) {
		--mailing-border: currentColor;
		--mailing-field: oklch(98% 0.01 220);
		--mailing-field-text: oklch(18% 0.02 220);
		--mailing-font: inherit;
		--mailing-button: oklch(18% 0.02 220);
		--mailing-button-text: oklch(98% 0.01 220);
	}

	:global(.mailing-list__intro h2) {
		margin: 0;
	}

	:global(.mailing-list__intro p),
	:global(.mailing-list__privacy) {
		margin: 0;
	}

	:global(.mailing-list__form) {
		border: 1px solid var(--mailing-border);
		padding: 1rem;
	}

	:global(._form_125 form) {
		margin: 0 !important;
		padding: 0 !important;
		border: 0 !important;
		background: transparent !important;
		box-shadow: none !important;
	}

	:global(._form_125 input[type="text"]),
	:global(._form_125 input[type="email"]) {
		width: 100% !important;
		margin: 0 0 0.65rem !important;
		border: 1px solid var(--mailing-border) !important;
		border-radius: 0 !important;
		background: var(--mailing-field) !important;
		color: var(--mailing-field-text) !important;
		font: inherit !important;
		box-shadow: none !important;
	}

	:global(._form_125 input[type="submit"]),
	:global(._form_125 button[type="submit"]) {
		width: 100% !important;
		margin: 0.25rem 0 0 !important;
		border: 1px solid var(--mailing-button) !important;
		border-radius: 0 !important;
		padding: 0.8rem 1rem !important;
		background: var(--mailing-button) !important;
		color: var(--mailing-button-text) !important;
		font: inherit !important;
		font-weight: 700 !important;
		cursor: pointer !important;
	}

	:global(._form_125 input:focus-visible),
	:global(._form_125 button:focus-visible) {
		outline: 3px solid currentColor !important;
		outline-offset: 3px !important;
	}

	:global(._form_125 label),
	:global(._form_125 div) {
		color: inherit !important;
		font-family: inherit !important;
	}

	:global(._form_125 .form-header),
	:global(._form_125 .form-footer),
	:global(._form_125 .powered-by) {
		display: none !important;
	}

	/* ActiveCampaign appends an ID-scoped stylesheet after this component.
	   Anchoring these rules to the page ID keeps the site palette and type
	   authoritative without relying on ActiveCampaign's generated form ID. */
	:global(#main-content .mailing-list ._form_125 form) {
		font-family: var(--mailing-font) !important;
	}

	:global(.mailing-list ._form_125 label),
	:global(.mailing-list ._form_125 ._form-label),
	:global(.mailing-list ._form_125 ._form_element ._form-label),
	:global(.mailing-list ._form_125 ._checkbox-radio label) {
		color: var(--mailing-field-text) !important;
	}

	:global(#main-content .mailing-list ._form_125 input[type="text"]),
	:global(#main-content .mailing-list ._form_125 input[type="email"]),
	:global(#main-content .mailing-list ._form_125 input[type="tel"]),
	:global(#main-content .mailing-list ._form_125 textarea),
	:global(#main-content .mailing-list ._form_125 select) {
		border: 1px solid var(--mailing-border) !important;
		border-radius: 0 !important;
		background: var(--mailing-field) !important;
		color: var(--mailing-field-text) !important;
		-webkit-text-fill-color: var(--mailing-field-text) !important;
		caret-color: var(--mailing-button) !important;
		font-family: var(--mailing-font) !important;
	}

	:global(#main-content .mailing-list ._form_125 input::placeholder),
	:global(#main-content .mailing-list ._form_125 textarea::placeholder) {
		color: var(--mailing-field-text) !important;
		-webkit-text-fill-color: var(--mailing-field-text) !important;
		opacity: 0.68 !important;
	}

	:global(#main-content .mailing-list ._form_125 input:-webkit-autofill) {
		box-shadow: 0 0 0 1000px var(--mailing-field) inset !important;
		-webkit-text-fill-color: var(--mailing-field-text) !important;
		caret-color: var(--mailing-button) !important;
	}

	:global(.mailing-list ._form_125 input[type="submit"]),
	:global(.mailing-list ._form_125 button[type="submit"]),
	:global(.mailing-list ._form_125 #_form_125_submit._submit) {
		border-color: var(--mailing-button) !important;
		background: var(--mailing-button) !important;
		color: var(--mailing-button-text) !important;
	}
</style>
