---
import SocialIcon from "@components/Socials/SocialIcon.astro"
import { getCollection } from "astro:content"

interface Props {
	class?: string
}

const className = Astro.props.class
const [links, socials] = await Promise.all([
	getCollection("links"),
	getCollection("socials")
])

links.sort((a, b) => a.data.order - b.data.order)
socials.sort((a, b) => a.data.order - b.data.order)
---

{
	(links.length > 0 || socials.length > 0) && (
		<nav class:list={["site-links", className]} aria-label="Frost Children links">
			{links.length > 0 && (
				<ul class="site-links__destinations">
					{links.map((link) => (
						<li>
							<a href={link.data.url} target="_blank" rel="noopener noreferrer">
								<span>{link.data.title}</span>
								{link.data.description && <small>{link.data.description}</small>}
							</a>
						</li>
					))}
				</ul>
			)}
			{socials.length > 0 && (
				<ul class="site-links__socials">
					{socials.map((social) => (
						<li>
							<a href={social.data.url} target="_blank" rel="noopener noreferrer">
								<span class="sr-only">{social.data.title}</span>
								<SocialIcon icon={social.data.icon} />
							</a>
						</li>
					))}
				</ul>
			)}
		</nav>
	)
}
