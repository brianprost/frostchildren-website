---
import { ClientRouter } from "astro:transitions"
import Seo from "@components/Seo/Seo.astro"

export interface Props {
	title: string
	description: string
	image?: ImageMetadata
	noindex?: boolean
	themeColor?: string
}

const {
	title,
	description,
	image,
	noindex = false,
	themeColor = "#800000"
} = Astro.props as Props
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
<link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicons/favicon-96x96.png" sizes="96x96" type="image/png" />
<link rel="icon" href="/favicons/favicon.ico" sizes="48x48" />
<link rel="manifest" href="/favicons/site.webmanifest" />
<meta name="theme-color" content={themeColor} />

<!-- other -->
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap-index.xml" />

<Seo title={title} description={description} image={image} noindex={noindex} />

<!-- no fallback as I saw issues with firefox fallback -->
<ClientRouter fallback="none" />
